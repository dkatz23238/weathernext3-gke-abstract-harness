# Copy to .env (gitignored) and fill in. Never commit real values.

# Required
OPENAI_API_KEY=
HARNESS_ADMIN_PASSWORD=

# Optional: Google Weather API nowcast tools
GOOGLE_WEATHER_API_KEY=

# Optional: Anthropic models (passed to the GKE deployment if set)
# ANTHROPIC_API_KEY=

# GKE deploy (deploy/gke/up.sh, down.sh): PROJECT is required there
PROJECT=
# REGION=us-east1               # WeatherNext 3 bucket region
# CLUSTER=abstract

# Optional: parallel WeatherNext chunk reads
# WN3_WORKERS=24
